NODE_ENV=development
PORT=3000

# Used by docker-compose.yml to create the database; keep DATABASE_URL in sync.
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://phsar:change_me@localhost:5433/phsar_fresh
REDIS_URL=redis://localhost:6380

JWT_ACCESS_SECRET=
OTP_SECRET=
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# true = simulate payments (no ABA credentials needed); false = use the real PayWay credentials below
PAYWAY_MOCK=true
PAYWAY_MERCHANT_ID=your_merchant_id
PAYWAY_API_KEY=your_api_key
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
PAYWAY_CALLBACK_URL=https://YOUR-PUBLIC-DOMAIN/api/v1/payments/payway/callback
PAYWAY_QR_LIFETIME_MINUTES=10

# --- production / more users (all optional) ---
# Number of proxies in front of the API (nginx, a load balancer). 0 = none.
TRUST_PROXY=0
# Browser origins allowed to call the API (comma separated). The mobile app
# and the admin panel's server don't need this.
CORS_ORIGINS=
# Requests per minute per IP (login, OTP, codes and chat have stricter limits).
THROTTLE_LIMIT=300
# Database connections per server copy.
DB_POOL_MAX=10
