# NestJS API (server-side only — the browser never talks to it directly)
API_URL=http://localhost:3000/api/v1

# Where images under /uploads are served from (the NestJS server), used by the browser
NEXT_PUBLIC_ASSET_URL=http://localhost:3000

# Live updates (Socket.io) go from the browser to the NestJS server.
# Leave empty to use NEXT_PUBLIC_ASSET_URL. In production, add the admin
# panel's address to CORS_ORIGINS in the backend's .env.
NEXT_PUBLIC_SOCKET_URL= 
